# GPU the sidecars use (nvidia-smi -L); leave empty for the first GPU
SOUNDSCAPE_GPU_UUID=
# Sidecars (defaults = the compose services; point at other hosts to share sidecars with another app)
YUE2_URL=http://yue2:3015
SHEETSAGE_URL=http://sheetsage:3016
CLIPGRAB_URL=http://clipgrab:3014
# Writer / planner LLM (OpenAI-compatible). Small local models are fine — the writing task is easy.
LLM_BASE_URL=http://host.docker.internal:30000/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=local
# Where saved songs, seeds and the SQLite database live (audio persists on disk by design)
LIBRARY_DIR=./library
API_PORT=3021
WEB_PORT=3020
